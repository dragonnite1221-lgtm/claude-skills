#!/usr/bin/env bash
# 200-line Python file-size gate. Enable once with:
#   git config core.hooksPath .githooks
# Blocks pushes that introduce new violations or grow a baselined file.
set -euo pipefail

if command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  PY=python
fi

"$PY" scripts/check_file_size.py
